# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ChangeMe123!

# =============================================================================
# RabbitMQ
# =============================================================================
RABBITMQ_DEFAULT_USER=developer
RABBITMQ_DEFAULT_PASS=ChangeMe123!

# =============================================================================
# Grafana Enterprise
# =============================================================================
# Web UI: http://<server>:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeMe123!
GRAFANA_USERS_ALLOW_SIGN_UP=false
GRAFANA_AUTH_ANONYMOUS_ENABLED=false

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=ChangeMe123!
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false
GF_PATHS_PROVISIONING=/etc/grafana/provisioning

# =============================================================================
# Loki
# =============================================================================
# Log retention period (days). Used by loki/config.yaml via config.expand-env.
LOKI_RETENTION_DAYS=10

# =============================================================================
# Prometheus
# =============================================================================
# Metrics TSDB retention (days). Self-scrape only until app /metrics is added.
PROMETHEUS_RETENTION_DAYS=15

# =============================================================================
# Docker container log rotation (json-file driver)
# =============================================================================
# Applied to every service in docker-compose.yml. Prevents unbounded Docker logs
# on disk; Alloy ships a copy to Loki for querying in Grafana.
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=3
