# =====================================================================
# Cloud development env sample (Claude Code cloud sessions, claude.ai/code)
#
# Why this file exists:
#   .sample.env targets the local devcontainer. In a cloud session the
#   containers run on the cloud VM instead, and some of its values don't
#   work there.
#
# How it is used:
#   scripts/cloud_bootstrap.sh copies this file to .env (only when .env is
#   missing, and only in cloud sessions). Locally, .sample.env is still the
#   file to copy.
#
# Differences from .sample.env (everything else is identical):
#   - MP_DATABASE and MP_LOG_FILE are absolute paths under /data, where
#     ./mailpit/data is mounted inside the mailpit container. The relative
#     ./mailpit/data/... paths don't exist inside the container, and
#     mailpit crashes on startup (panic in storage.InitDB).
#   Keep this file in sync with .sample.env when adding or changing keys.
#
# Contains local development values only. Never put real secrets here.
# =====================================================================

project_name=webapp

# RabbitMQ configuration
RABBITMQ_DEFAULT_USER=developer
RABBITMQ_DEFAULT_PASS=password

# Mailpit configuration
MP_MAX_MESSAGES=5000
MP_DATABASE=/data/mailpit.db
MP_LOG_FILE=/data/mailpit.log
# 👇 mailpit UI credentials in form of username:password
MP_UI_AUTH=developer:password
# 👇 mailpit SMTP credentials in form of username:password
MP_SMTP_AUTH=developer:password
MP_SMTP_AUTH_ACCEPT_ANY=false
MP_SMTP_AUTH_ALLOW_INSECURE=true
